{
  "name": "server",
  "version": "1.0.0",
  "description": "API for the IITR Chess Leaderboard: Chess.com sync, live updates and Swiss tournaments",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register/transpile-only --test tests/*.test.ts",
    "test:integration": "node --require ts-node/register/transpile-only --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "players": "ts-node scripts/players.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
