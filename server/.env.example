# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Supabase, Neon, or local).
# When connecting through a pooler such as PgBouncer or Supabase's pooler, add ?pgbouncer=true.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Signs the short-lived tokens the web app sends to this API.
# Must be the same value as AUTH_SECRET in client/.env.local. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

PORT=5000

# Browser origins allowed to call the API and open live-update sockets, comma-separated.
CLIENT_ORIGIN="http://localhost:3000"

# Optional: Redis for the leaderboard cache (e.g. Upstash). Without it the API reads Postgres directly.
# REDIS_URL="rediss://default:password@host:port"

# Optional: contact details sent in the User-Agent, so Chess.com can reach you before rate-limiting the app.
# CHESS_COM_CONTACT="you@example.com"

# Optional: how often to re-sync every player from Chess.com (cron syntax). Default: every 10 minutes.
# SYNC_CRON="*/10 * * * *"

# Optional: which email domain may join the leaderboard. Its subdomains count too
# (name@ece.iitr.ac.in). Default: iitr.ac.in
# INSTITUTE_EMAIL_DOMAIN="iitr.ac.in"

# Optional: log every SQL query (noisy; development only).
# PRISMA_LOG_QUERIES=true
