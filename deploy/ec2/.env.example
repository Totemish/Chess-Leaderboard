# Save as /opt/iitr-chess/.env on the EC2 server. Read by docker compose.

# The website's address and the API's address (no https://).
WEB_DOMAIN=chess.example.com
API_DOMAIN=api.chess.example.com

# Your GitHub username or organisation, in lowercase. The images are
# ghcr.io/<IMAGE_OWNER>/iitr-chess-web and ghcr.io/<IMAGE_OWNER>/iitr-chess-api.
IMAGE_OWNER=your-github-username

# Optional: deploy a specific build instead of the latest (a commit SHA).
# IMAGE_TAG=latest
