# Save as /opt/iitr-chess/web.env on the EC2 server. Never commit the real file.

# Same value as AUTH_SECRET in api.env.
AUTH_SECRET=
# The website's full address.
AUTH_URL=https://chess.example.com

# OAuth apps. Each provider's redirect URL must be <AUTH_URL>/api/auth/callback/<provider>,
# e.g. https://chess.example.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# NEXT_PUBLIC_API_URL is not set here: it is baked into the website when GitHub
# Actions builds it, from the repository variable of the same name.
