# Save as /opt/iitr-chess/api.env on the EC2 server. Never commit the real file.

# Your Supabase connection string (the same one as in server/.env).
DATABASE_URL=

# Same value as AUTH_SECRET in web.env. Generate with: openssl rand -base64 32
AUTH_SECRET=

# The website's full address, so browsers there may call the API.
CLIENT_ORIGIN=https://chess.example.com

# Optional: contact details for Chess.com's API team.
# CHESS_COM_CONTACT=you@example.com

# Optional: Redis cache (e.g. Upstash rediss:// URL). Not needed for a club-sized site.
# REDIS_URL=
