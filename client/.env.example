# Copy to .env.local and fill in. Never commit .env.local.

# Must match AUTH_SECRET in server/.env. Generate one with: openssl rand -base64 32
AUTH_SECRET=""
# The public URL of this web app.
AUTH_URL=http://localhost:3000

# OAuth apps. Redirect URI for each: <AUTH_URL>/api/auth/callback/<provider>
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Public URL of the Express API. Baked into the browser bundle at build time,
# so set it before building (e.g. in Vercel's environment settings).
NEXT_PUBLIC_API_URL=http://localhost:5000
